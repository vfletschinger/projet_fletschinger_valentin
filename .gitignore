# Règles communes à tous les projets du dépôt.
# Chaque projet Angular garde aussi son propre .gitignore (généré par `ng new`).

# Dépendances
node_modules/

# Builds et caches
dist/
out-tsc/
tmp/
.angular/
coverage/
__screenshots__/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables d'environnement / secrets
.env
.env.*
!.env.example

# IDE
.idea/
*.sublime-workspace
.history/

# Claude Code (réglages locaux)
.claude/settings.local.json

# Système
.DS_Store
Thumbs.db
desktop.ini
